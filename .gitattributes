<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>EcoApp Simple</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      max-width: 600px;
      margin: auto;
      background: #f3f3f3;
    }
    h2 { margin-top: 30px; }
    input { padding: 6px; margin: 5px 0; width: 100%; }
    .card {
      background: white;
      padding: 15px;
      border-radius: 8px;
      margin-top: 10px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }
    .mapita { 
      background: #dcdcdc; 
      height: 200px; 
      border-radius: 8px; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      font-size: 18px; 
    }
  </style>
</head>

<body>

  <h1>Mini EcoApp</h1>
  <p>No ocupa instalar nada. No sermonea. Solo datos.</p>

  <div class="card">
    <h2>Medidor rápido de huella</h2>

    <label>Electricidad (kWh/mes)</label>
    <input id="electricidad" type="number" value="150">

    <label>Kilómetros en coche por semana</label>
    <input id="transporte" type="number" value="80">

    <label>Porciones de carne por semana</label>
    <input id="carne" type="number" value="3">

    <label>Gadgets (cantidad)</label>
    <input id="gadgets" type="number" value="3">

    <button onclick="calcular()" style="margin-top:10px;padding:10px;width:100%;cursor:pointer;">
      Calcular CO₂
    </button>

    <div id="resultado" style="margin-top:15px;font-weight:bold;"></div>
  </div>


  <div class="card">
    <h2>Mapa de Soluciones (versión básica)</h2>
    <div class="mapita">Aquí iría el mapa real (esta es la versión simple)</div>

    <ul id="lugares"></ul>
  </div>


<script>
  // Factores aproximados
  const FACTORES = {
    electricidad: 0.45,    // kg CO2 por kWh
    transporte: 0.21,      // kg CO2 por km
    carne: 7,              // kg CO2 por porción
    gadgetHora: 0.1        // kWh aprox.
  };

  function calcular() {
    const e = Number(document.getElementById("electricidad").value) || 0;
    const t = Number(document.getElementById("transporte").value) || 0;
    const c = Number(document.getElementById("carne").value) || 0;
    const g = Number(document.getElementById("gadgets").value) || 0;

    const co2 = 
      e * FACTORES.electricidad +
      (t * 4) * FACTORES.transporte + // 4 semanas
      c * FACTORES.carne +
      (g * 2 * 30) * FACTORES.gadgetHora; // 2 horas por día aprox.

    document.getElementById("resultado").innerText =
      "Generas aprox: " + co2.toFixed(1) + " kg de CO₂ al mes.";
  }

  // “Mapa” simple: datos locales fake
  const soluciones = [
    { nombre: "Centro de Reciclaje Norte", tipo: "Reciclaje" },
    { nombre: "Solar MX (paneles)", tipo: "Energía renovable" },
    { nombre: "Taller de reparación ecológica", tipo: "Reutilización" }
  ];

  const lista = document.getElementById("lugares");
  soluciones.forEach(s => {
    const li = document.createElement("li");
    li.textContent = `${s.nombre} — ${s.tipo}`;
    lista.appendChild(li);
  });
</script>

</body>
</html>
